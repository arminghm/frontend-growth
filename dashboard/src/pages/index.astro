---
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainCard from '../components/DomainCard.astro';
import LevelBadge from '../components/LevelBadge.astro';
import {
  loadCurrentProgress,
  loadProgressHistory,
  loadTimeline
} from '../lib/progress';

const current = await loadCurrentProgress();
const history = await loadProgressHistory();
const timeline = await loadTimeline();

const distribution = Array.from({ length: 6 }, (_, score) => ({
  score,
  count: current.domains
    .flatMap((domain) => domain.subskills)
    .filter((subskill) => Math.round(subskill.score) === score)
    .length,
}));

const strongest = [...current.domains].sort((a, b) => b.score - a.score).slice(0, 4);
const biggestGaps = [...current.domains].sort((a, b) => a.score - b.score).slice(0, 4);
---
<BaseLayout title="Frontend Growth Dashboard">
  <main class="shell">
    <header class="hero">
      <div>
        <span class="eyebrow">FRONTEND GROWTH</span>
        <h1>Learning Progress Dashboard</h1>
        <p class="lede">
          Evidence-driven proficiency tracking for Senior Frontend interview readiness.
        </p>
      </div>

      <aside class="focus-card">
        <span>Current focus</span>
        <strong>{current.currentFocus}</strong>
        <small>Updated {current.updatedAt}</small>
      </aside>
    </header>

    <section class="summary-grid">
      <article class="panel">
        <span class="kicker">STRONGEST AREAS</span>
        <div class="stack-list">
          {strongest.map((domain) => (
            <div class="summary-row">
              <span>{domain.name}</span>
              <LevelBadge score={domain.score} />
            </div>
          ))}
        </div>
      </article>

      <article class="panel">
        <span class="kicker">CURRENT GAPS</span>
        <div class="stack-list">
          {biggestGaps.map((domain) => (
            <div class="summary-row">
              <span>{domain.name}</span>
              <LevelBadge score={domain.score} />
            </div>
          ))}
        </div>
      </article>

      <article class="panel">
        <span class="kicker">SKILL DISTRIBUTION</span>
        <div class="distribution">
          {distribution.map(({ score, count }) => (
            <div class="distribution__item">
              <strong>{count}</strong>
              <span>L{score}</span>
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="kicker">OVERVIEW</span>
          <h2>Domains & subskills</h2>
        </div>
        <p>
          0 UNKNOWN · 1 AWARE · 2 EXPLAIN · 3 APPLY · 4 REASON · 5 DESIGN/TEACH
        </p>
      </div>

      <div class="domain-grid">
        {current.domains.map((domain) => (
          <DomainCard domain={domain} />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="kicker">PROGRESS OVER TIME</span>
          <h2>Historical snapshots</h2>
        </div>
        <p>Snapshots are added only after meaningful proficiency changes.</p>
      </div>

      <div class="panel history-table-wrap">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              {current.domains.map((domain) => <th>{domain.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {history.snapshots.map((snapshot) => (
              <tr>
                <td>{snapshot.date}</td>
                {current.domains.map((domain) => (
                  <td>{snapshot.scores[domain.id]?.toFixed(1) ?? '—'}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="kicker">TIMELINE</span>
          <h2>Evidence & milestones</h2>
        </div>
      </div>

      <div class="timeline">
        {timeline.items.map((item) => (
          <article class="timeline-item">
            <time>{item.date}</time>
            <div>
              <div class="timeline-title">
                <strong>{item.title}</strong>
                <span class="timeline-type">{item.type}</span>
              </div>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer>
      <span>Canonical source of truth: <strong>arminghm/frontend-growth</strong></span>
      <span>Dashboard data is a projection of repository evidence, not independent evidence.</span>
    </footer>
  </main>
</BaseLayout>
